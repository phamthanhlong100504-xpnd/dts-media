# Example only. Spring Boot/Gradle do not automatically load this file.
# Export these variables in the terminal/IDE that starts Media.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5437/media
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_CLIENT_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MEDIA_GET_URL_EXPIRY_MINUTES=60
MEDIA_PUT_URL_EXPIRY_MINUTES=15
SPRING_JPA_HIBERNATE_DDL_AUTO=none
# Set true deliberately for reviewed, pending migration files.
SPRING_FLYWAY_ENABLED=false
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
