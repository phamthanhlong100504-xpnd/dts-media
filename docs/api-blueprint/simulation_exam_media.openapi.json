{
  "openapi": "3.0.3",
  "info": {
    "title": "DTS Card05 Media exam RPC",
    "version": "v1-20261102",
    "description": "Source-authored Media contract; not live Swagger export or runtime acceptance. Frontend uses Practice session APIs. Ticket protocols are documented in simulation_exam_media.md."
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1/media"
    }
  ],
  "paths": {
    "/simulation-exam/eligibility": {
      "post": {
        "operationId": "simulationExamMediaEligibility",
        "summary": "Check1–16 attested candidates without issuing URLs; verify current private-object Range/SHA, preserve candidate order.",
        "security": [
          {
            "IdentityBearer": []
          }
        ],
        "x-required-permissions": [
          "media:read",
          "simulations:read",
          "simulations:exam"
        ],
        "x-internal-practice-rpc": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Raw DTO, no ApiResponse envelope.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EligibilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body; exactly ticket field is accepted.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaError"
                }
              }
            }
          },
          "401": {
            "description": "Access JWT missing or rejected by native Media filter.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaError"
                }
              }
            }
          },
          "403": {
            "description": "Missing required rights or invalid/expired/mismatched ticket.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaError"
                }
              }
            }
          },
          "409": {
            "description": "Playback video unavailable, out of scope, or changed ETag/asset.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server failure; do not assume readiness or completed playback.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaError"
                }
              }
            }
          },
          "503": {
            "description": "Storage, policy verification, network or URL signing unavailable.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaError"
                }
              }
            }
          }
        }
      }
    },
