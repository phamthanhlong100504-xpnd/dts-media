  "components": {
    "securitySchemes": {
      "IdentityBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "TicketRequest": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "Practice-signed domain-specific ticket; never minted or persisted by frontend."
          }
        },
        "required": [
          "ticket"
        ],
        "additionalProperties": false
      },
      "AttestedAsset": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "videoTrackDurationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          }
        },
        "required": [
          "mediaId",
          "fileName",
          "sha256",
          "durationMs",
          "videoTrackDurationMs"
        ],
        "additionalProperties": false
      },
      "EligibilityItem": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "ready": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "videoTrackDurationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "objectEtag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "enum": [
              "READY",
              "MISSING",
              "NOT_READY",
              "SCOPE_MISMATCH",
              "ASSET_MISMATCH",
              "OPAQUE_PATH_REQUIRED",
              "OBJECT_MISMATCH",
              "RANGE_UNAVAILABLE",
              "VIDEO_FORMAT_INVALID",
              "OBJECT_SHA_MISMATCH",
              "OBJECT_MISSING",
              "OBJECT_CHANGED"
            ]
          }
        },
        "required": [
          "mediaId",
          "ready",
          "durationMs",
          "videoTrackDurationMs",
          "reason"
        ],
        "additionalProperties": false
      },
      "EligibilityResponse": {
        "type": "object",
        "properties": {
          "bankVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/EligibilityItem"
            }
          }
        },
        "required": [
          "bankVersion",
          "manifestSha256",
          "items"
        ],
        "additionalProperties": false
      },
      "PlaybackResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "playbackEventId": {
            "type": "string",
            "format": "uuid"
          },
          "bankVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expiredAt": {
            "type": "string",
            "format": "date-time"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "video/mp4"
            ]
          },
          "durationMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "usage": {
            "type": "string",
            "enum": [
              "CURRENT",
              "REVIEW"
            ]
          }
        },
        "required": [
          "sessionId",
          "position",
          "playbackEventId",
          "bankVersion",
          "manifestSha256",
          "mediaId",
          "url",
          "expiredAt",
          "mimeType",
          "durationMs",
          "usage"
        ],
        "additionalProperties": false
      },
      "MediaError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "error",
          "message"
        ],
        "additionalProperties": false
      }
    }
  }
}
